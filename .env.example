# TsukiAI VoiceChat environment template (C# app side)
#
# IMPORTANT:
# - This file is a template only.
# - Copy to ".env" at project root if you want env-based overrides.
# - Discord bridge runtime keys (DISCORD_TOKEN, AssemblyAI key file path, etc.) are in:
#   discord-voice-bridge/.env
#
# Current deployment flow:
# Discord PCM -> AssemblyAI v3 realtime STT -> TsukiAI API/LLM -> private
# OpenVoice V2 CPU service -> Discord playback.

# ------------------------------
# Discord metadata (optional for C# side)
# ------------------------------
TSUKI_DISCORD_BOT_TOKEN=
TSUKI_DISCORD_GUILD_ID=
TSUKI_DISCORD_CHANNEL_ID=
# 0 = all users, max ulong (18446744073709551615) = auto focus
TSUKI_DISCORD_FOCUSED_USER_ID=18446744073709551615

# ------------------------------
# API keys (C# side)
# ------------------------------
TSUKI_ASSEMBLYAI_API_KEY=
TSUKI_DEEPL_API_KEY=
TSUKI_REMOTE_INFERENCE_API_KEY=

# ------------------------------
# Remote inference + OpenVoice endpoint (C# side)
# ------------------------------
# Example provider URLs:
# - Cerebras: https://api.cerebras.ai/v1
# - Kimi:     https://api.moonshot.ai/v1
TSUKI_REMOTE_INFERENCE_URL=https://api.cerebras.ai/v1

TSUKI_OPENVOICE_URL=http://host.docker.internal:8000
TSUKI_OPENVOICE_API_KEY=

# ------------------------------
# Model + translation
# ------------------------------
# For provider mode this may be auto-normalized by settings/runtime.
TSUKI_MODEL_NAME=llama3.1-8b
TSUKI_USE_DEEPL_TRANSLATE=false
TSUKI_USE_DEEPL_FREE_API=true

# ------------------------------
# Voice runtime flags (must stay true for /api/voice/*)
# ------------------------------
TSUKI_VOICE_RUNTIME_V2=true
TSUKI_VOICE_API_CONTROLLER=true

# ------------------------------
# Voice tone preset used by the language model before OpenVoice synthesis.
# Default = Tsuki voice style set (20 normal, 79 joy, 77 crying, 78 anger, 80 relaxed).
# TSUKI_VOICE_TONE_STYLES=normal=20,happy=79,sad=77,angry=78,calm=80

# Semantic memory resilience (C# side)
# ------------------------------
# Enable long-lived Python worker process for semantic memory RPC.
TSUKI_SEMANTIC_PERSISTENT_WORKER=true
# Open local semantic-memory circuit after this many consecutive failures.
TSUKI_SEMANTIC_CB_FAILURES=5
# Circuit cooldown before half-open retry.
TSUKI_SEMANTIC_CB_COOLDOWN_MS=30000
# Per semantic request timeout.
TSUKI_SEMANTIC_REQUEST_TIMEOUT_MS=8000

# ==============================
# WEB DEPLOYMENT (TsukiAI.Api on VPS) — 2026-09 migration
# ==============================
# These are read by the web API only; the desktop app ignores them.

# Login password for the web UI (REQUIRED in Docker; without it the API only
# binds to localhost as a guard).
TSUKI_WEB_PASSWORD=

# Provider failover: on a Groq 429 the pipeline cycles to the next provider in
# the list (hot, no restart). All listed providers need their key set above.
TSUKI_USE_MULTIPLE_PROVIDERS=false
TSUKI_MULTI_PROVIDERS_CSV=groq,cerebras,gemini,mistral

# Shared secret for machine clients (discord-voice-bridge on the VPS). Sent as
# the X-Api-Key header. Required when running the bridge service.
TSUKI_API_KEY=

# Public hostname routed through the Cloudflare Tunnel to the HTTP origin.
DOMAIN=tsukihime.dpdns.org

# Per-provider LLM keys (strip these from any copied settings.json — see
# scripts/import-local-data.ps1). Only the providers you use need values.
TSUKI_CEREBRAS_API_KEY=
TSUKI_GROQ_API_KEY=
# Optional comma/newline-separated Groq keys. The Discord bridge, API STT,
# and desktop microphone rotate through these when a key is rejected or
# unavailable.
TSUKI_GROQ_API_KEYS=
# Optional newline-separated Groq key file for local C# clients. If set, it
# takes precedence over the inline values above.
TSUKI_GROQ_API_KEYS_FILE=
# Optional host path to the same newline-separated Groq key file for Docker.
# Keep the file outside Git (for example: C:/secrets/groq.txt).
GROQ_KEYS_HOST_PATH=
# Optional comma/newline-separated AssemblyAI keys for the Discord bridge.
# Prefer ASSEMBLYAI_KEYS_HOST_PATH for a read-only external key file.
TSUKI_ASSEMBLYAI_API_KEYS=
# Optional host path used by docker-compose to mount the newline-separated
# AssemblyAI key file into the bridge container. Keep the file outside Git.
ASSEMBLYAI_KEYS_HOST_PATH=
TSUKI_GEMINI_API_KEY=
TSUKI_GITHUB_API_KEY=
TSUKI_MISTRAL_API_KEY=

# Optional C#-side speech-to-text fallback. The Discord bridge uses Azure Speech
# first when STT_MODE=azure; it can fall back to Groq before using this path.
TSUKI_GROQ_STT_API_KEY=
TSUKI_GROQ_STT_MODEL=whisper-large-v3

# Semantic memory (ChromaDB). docker-compose.yml sets the URL to the sibling
# container automatically; enable memory with the flag below.
# TSUKI_CHROMA_URL=http://chromadb:8000
TSUKI_SEMANTIC_MEMORY_ENABLED=false

# Supermemory for the Discord/API process. When set and semantic memory is
# enabled, this takes precedence over ChromaDB for Discord voice + text.
TSUKI_SUPERMEMORY_API_KEY=
TSUKI_SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# The desktop app intentionally uses a separate Supermemory configuration.
TSUKI_DESKTOP_SUPERMEMORY_API_KEY=
TSUKI_DESKTOP_SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# Where the API stores settings/history/provider state (set in Dockerfile: /data).
# TSUKI_DATA_DIR=/data
