flowchart TD
    A[Game Starts] --> B[Auth Screen]
    B --> C{Restore saved session?}
    C -->|Yes| D[restore_saved_session]
    C -->|No| E[Login or Register]
    E --> F[login_with_email / register_with_email]
    D --> G[Main Menu]
    F --> G

    G --> H{Solo or Multiplayer?}
    H -->|Solo| I[Load game directly]
    H -->|Multiplayer| J[Set player name]
    J --> K[connect_to_server]
    K --> L[_ensure_client]
    L --> M{Authenticated already?}
    M -->|No| N[Device auth fallback]
    M -->|Yes| O[Create realtime socket]
    N --> O
    O --> P[Connect socket]
    P --> Q[Bind presence and state listeners]

    Q --> R{Host or Join?}
    R -->|Host| S[create_room]
    S --> T[_generate_room_code]
    T --> U[RPC create_room]
    U --> V[join_match_async]
    V --> W[Store local player and emit match_joined]

    R -->|Join| X[join_room]
    X --> Y[Normalize room code]
    Y --> Z[RPC join_room]
    Z --> AA[join_match_async]
    AA --> AB[Store local player and known presences]
    AB --> AC[Send player_info]
    AC --> AD[Send request_players]
    AD --> W

    W --> AE[Room Lobby]
    AE --> AF[enter_lobby]
    AF --> AG[Send local player_info]
    AG --> AH[Listen for player_joined / player_left / match_phase_changed]

    AH --> AI{Presence event?}
    AI -->|Player joined| AJ[_on_match_presence joins]
    AJ --> AK[Add player presence]
    AK --> AL[Send our player_info back]

    AI -->|Player left| AM[_on_match_presence leaves]
    AM --> AN[Remove player, class, subclass data]

    AH --> AO{Match state received?}
    AO -->|OP_PLAYER_JOIN| AP[_on_match_state]
    AP --> AQ[Reconcile authoritative join data]

    AO -->|OP_PLAYER_LEAVE| AR[_on_match_state]
    AR --> AS[Remove authoritative leave data]

    AO -->|OP_STATE| AT[_on_match_state]
    AT --> AU[Update phase]
    AU --> AV[Reconcile full player snapshot]

    AO -->|player_info| AW[_on_match_state]
    AW --> AX[Update player identity, host flag, slime variant]

    AE --> AY{Host starts match?}
    AY -->|Yes| AZ[Send OP_START_GAME]
    AZ --> BA[Server changes phase to in_game]
    BA --> BB[Clients receive OP_START_GAME]
    BB --> BC[Transition to loading/game scene]

    BC --> BD[Game Scene Ready]
    BD --> BE[Bind socket listeners again]
    BE --> BF[MultiplayerUtils.set_local_player]
    BF --> BG[start_input_update_loop]

    BG --> BH[Read local movement / attack / dash]
    BH --> BI[send_input OP_INPUT to server]

    BI --> BJ[Authoritative server processes input]
    BJ --> BK[Server updates player state]
    BK --> BL[Server broadcasts OP_STATE snapshot]

    BL --> BM[_handle_server_snapshot]
    BM --> BN{Is snapshot for local player?}
    BN -->|Yes| BO[reconcile_local_player]
    BN -->|No| BP[Spawn or update remote player]
    BP --> BQ[update_remote_player_target]
    BQ --> BR[interpolate_remote_players]

    BD --> BS{Other gameplay messages}
    BS -->|chat_message| BT[Display chat]
    BS -->|enemy_hit| BU[Apply remote enemy damage locally]
    BS -->|skill_stat_update| BV[Apply remote derived stats]
    BS -->|subclass_selected| BW[Apply remote subclass modifiers]

    BX[disconnect_server / logout / socket close] --> BY[_cleanup_socket_connection]
    BY --> BZ[_reset_match_state]
    BZ --> CA[Return to menu or auth]
