[Unit]
Description=TsukiAI private VPS controls
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/tsukiai
ExecStart=/usr/bin/python3 /opt/tsukiai/controls/server.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
