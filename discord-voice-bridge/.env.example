DISCORD_TOKEN=
GUILD_ID=
VOICE_CHANNEL_ID=
# Text channel where @-mentions get a text reply (requires Message Content intent)
TEXT_CHANNEL_ID=
# mention = reply only when @-mentioned (default) | any = read every message in the channel
TEXT_REPLY_MODE=mention
# Per-user cooldown for text replies (ms)
TEXT_USER_COOLDOWN_MS=3000
# Voice replies in text chat: all | keywords | off
TEXT_VOICE_MODE=all
# Keywords that trigger a voice reply when TEXT_VOICE_MODE=keywords
TEXT_VOICE_KEYWORDS=voice,say it,say that,speak,talk,sing,read it

# TsukiAI API endpoint. On the VPS (docker-compose) this points at the api
# container: http://api:8080. Locally, leave the default for the desktop app.
CSHARP_API_URL=http://localhost:5000

# Matches TSUKI_API_KEY on the API server (required when the API runs with
# cookie auth on a public host). Leave empty for the desktop app.
CSHARP_API_KEY=

# STT mode: azure | groq | assemblyai | local
# AssemblyAI is the realtime Discord voice path; Groq is the outage fallback.
STT_MODE=assemblyai
STT_FALLBACK_MODE=groq
USE_CLOUD_STT=true
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# One locale per Azure REST request. Use ja-JP for Japanese voice input.
AZURE_STT_LANGUAGE=en-US
# Preferred: comma- or newline-separated Groq keys. The bridge rotates to the
# next key on auth, rate-limit, network, timeout, or server failures.
GROQ_API_KEYS=
# Optional path to a newline-separated key file. Docker deployment mounts the
# dedicated host-side groq.keys file here so long lists are not truncated.
GROQ_API_KEYS_FILE=
# Legacy single-key fallback when GROQ_API_KEYS is empty.
GROQ_API_KEY=
# AssemblyAI v3 realtime keys. Prefer a newline-separated external file so
# multiple keys can rotate without putting secrets in this repository.
ASSEMBLYAI_KEYS_FILE=
ASSEMBLYAI_API_KEYS=
# Legacy single-key fallback when ASSEMBLYAI_KEYS_FILE/API_KEYS is empty.
ASSEMBLYAI_API_KEY=

# Bridge HTTP server
BRIDGE_HTTP_PORT=3001

# Voice activity detection
VAD_RMS_THRESHOLD=300
VAD_SILENCE_FRAMES=45
VAD_MAX_SEGMENT_SEC=12
VAD_MAX_TURN_SEC=30
VAD_END_OF_TURN_MS=1800
VAD_USER_COOLDOWN_MS=3000
VAD_MIN_SEGMENT_BYTES=9600

# Feature flags and performance tuning
VAD_BATCHING_ENABLED=false
VAD_FRAME_BATCH_SIZE=5
HTTP_KEEPALIVE_ENABLED=true
HTTP_MAX_SOCKETS=10
HTTP_MAX_FREE_SOCKETS=5
HTTP_KEEPALIVE_MS=30000
DEBUG=false

# AssemblyAI realtime connection lifecycle
ASSEMBLYAI_CONNECT_TIMEOUT_MS=12000
ASSEMBLYAI_CLOSE_TIMEOUT_MS=8000
