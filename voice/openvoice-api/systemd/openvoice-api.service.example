[Unit]
Description=TsukiAI OpenVoice V2 CPU TTS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<VM_USER>
WorkingDirectory=/opt/openvoice/app
EnvironmentFile=/opt/openvoice/openvoice.env
ExecStart=/opt/openvoice/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openvoice /tmp

[Install]
WantedBy=multi-user.target
