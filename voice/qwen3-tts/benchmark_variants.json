{
  "version": 1,
  "notes": [
    "Restart the Qwen worker between variants; PyTorch inter-op thread count is process-global and must be set before inference.",
    "Do not change sampling parameters between variants.",
    "Gate 2 token variants are evaluated after selecting the safest Gate 1 runtime configuration.",
    "Gate 1/2 evidence requires a verified trained-custom artifact; unverified runs are rehearsal evidence only."
  ],
  "variants": [
    {
      "id": "gate1-A",
      "gate": 1,
      "description": "FP32 eager, 4 intra-op threads, reference inter-op policy.",
      "env": {
        "QWEN_TTS_ATTN_IMPLEMENTATION": "eager",
        "QWEN_TTS_INTRA_OP_THREADS": "4",
        "QWEN_TTS_INTER_OP_THREADS": "4",
        "QWEN_TTS_MAX_NEW_TOKENS": "2048"
      },
      "expected_runtime": {
        "precision": "float32",
        "attention_implementation": "eager",
        "intra_op_threads": 4,
        "inter_op_threads": 4,
        "max_new_tokens": 2048,
        "sampling_profile": "trained-custom-v2"
      }
    },
