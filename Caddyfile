# Cloudflare Tunnel terminates public HTTPS before forwarding to this HTTP origin.
# The API container serves both the SPA and the API.
http://{$DOMAIN} {
	encode gzip
	reverse_proxy api:8080
}

# Public standalone profile; only this hostname can serve these files.
http://profile.tsukihime.dpdns.org {
	encode gzip
	root * /srv/profile
	header X-Content-Type-Options nosniff
	header Referrer-Policy no-referrer
	header X-Tsuki-Profile-Origin tsukis-bedroom
	file_server
}
